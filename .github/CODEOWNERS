# Code owners for myjourny-frontend. See CONTRIBUTING.md → "Who reviews what".
#
# Owners on one line are OR'd: an approval from ANY listed team satisfies the
# code-owner review. The LAST matching pattern wins, so the guardrails block
# below overrides the default for those paths.
#
#   @MyItinerary/frontend-reviewers  — app code (features, routes, components, lib, tests)
#   @MyItinerary/engineering-manager — co-owner of app code; sole owner of guardrails

# Default: all app code.
*                                @MyItinerary/frontend-reviewers @MyItinerary/engineering-manager

# Guardrails: nobody (human or AI) may weaken these without the engineering
# manager. frontend-reviewers alone cannot approve changes here.
/.github/                        @MyItinerary/engineering-manager
/eslint.config.mjs               @MyItinerary/engineering-manager
/scripts/check-architecture.mjs  @MyItinerary/engineering-manager
/vitest.config.mts               @MyItinerary/engineering-manager
/vitest.setup.ts                 @MyItinerary/engineering-manager
/playwright.config.ts            @MyItinerary/engineering-manager
/package.json                    @MyItinerary/engineering-manager
/package-lock.json               @MyItinerary/engineering-manager
/tsconfig.json                   @MyItinerary/engineering-manager
/AGENTS.md                       @MyItinerary/engineering-manager
/CLAUDE.md                       @MyItinerary/engineering-manager
/CONTRIBUTING.md                 @MyItinerary/engineering-manager
/.cursor/                        @MyItinerary/engineering-manager
